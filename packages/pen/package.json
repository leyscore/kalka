{
  "name": "@kalka/pen",
  "version": "0.1.0-beta.5",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "check": "bun run typecheck && bun run build && bun run smoke:dist",
    "prepack": "bun run build",
    "smoke:dist": "bun scripts/smoke-dist.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leyscore/kalka.git",
    "directory": "packages/pen"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@kalka/scene-graph": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsdown": "^0.22.14",
    "typescript": "~5.8.3"
  }
}
