    "@nanostores/vue": "^1.1.0",
    "@paper-design/shaders": "0.0.81",
    "@vueuse/core": "^14.4.0",
    "es-toolkit": "^1.52.0",
    "fuse.js": "^7.5.0",
    "js-base64": "^3.9.3",
    "nanostores": "^1.5.4",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.5",
    "reka-ui": "^2.10.5"
