{
  "name": "@kalka/electron",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "bun scripts/build-mcp.ts && bun build src/main.ts --target=node --format=esm --outfile=dist/main.js --external electron && bun build src/preload.ts --target=node --format=cjs --outfile=dist/preload.cjs --external electron && bun run build:render-host",
    "build:render-host": "bun build src/render-host.ts --target=node --format=esm --outfile=dist/render-host.js --external electron",
    "start": "bun run build && electron .",
    "dev": "bun scripts/dev.ts",
    "package": "bun run build && electron-builder --publish never",
    "package:dir": "bun run build && electron-builder --dir --publish never",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.10",
    "smol-toml": "1.9.0"
  },
  "productName": "Kalka",
  "version": "0.1.0-beta.2",
  "description": "Design like you do in Figma. Every layer is real HTML and CSS.",
  "build": {
    "appId": "design.kalka.app",
    "productName": "Kalka",
    "copyright": "Kalka contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "protocols": [
      {
        "name": "Kalka link",
        "schemes": [
          "kalka"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "kalka",
        "name": "Kalka document",
        "role": "Editor"
      },
      {
        "ext": "fig",
        "name": "Figma file",
        "role": "Editor"
      },
      {
        "ext": "pen",
        "name": "Pencil file",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "darkModeSupport": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "executableName": "kalka"
    },
    "asarUnpack": [
      "dist/mcp/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "leyscore",
        "repo": "kalka",
        "releaseType": "draft"
      }
    ]
  }
}
