# Kalka server settings (Docker). Copy to .env and fill in.

# Typed once on the server's page to create the first administrator. openssl rand -hex 16
KALKA_SETUP_CODE=
# The name people see when they connect from Kalka.
KALKA_SERVER_NAME=Kalka
# The server's public address, when a reverse proxy hides it (https://kalka.example.com).
KALKA_PUBLIC_URL=
# Web editors allowed to receive sign-in codes, comma-separated (https://kalka.design).
KALKA_APP_ORIGINS=
# "false" turns off email and password sign-in once single sign-on works.
KALKA_LOCAL_LOGIN=true

# Email (optional): invitations, password resets, seat warnings.
KALKA_SMTP_HOST=
KALKA_SMTP_PORT=587
KALKA_SMTP_SECURE=starttls
KALKA_SMTP_USER=
KALKA_SMTP_PASSWORD=
KALKA_SMTP_FROM=Kalka <kalka@example.com>

# Single sign-on (needs a license key; free for up to 5 people at kalka.design).
KALKA_LICENSE_KEY=
KALKA_OIDC_ISSUER=
KALKA_OIDC_CLIENT_ID=
KALKA_OIDC_CLIENT_SECRET=
KALKA_OIDC_LABEL=
KALKA_OIDC_ADMIN_GROUPS=
KALKA_OIDC_EDITOR_GROUPS=
KALKA_OIDC_VIEWER_GROUPS=
KALKA_OIDC_ALLOWED_GROUPS=
KALKA_OIDC_DEFAULT_ROLE=editor

# Business features (need a Business license key). Each can also be set in the console,
# under Server; a value here wins and shows as locked there.
# KALKA_AUDIT_RETENTION_DAYS=365
# Managed backups to S3-compatible storage (R2, B2, MinIO, AWS S3).
# KALKA_BACKUP_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# KALKA_BACKUP_BUCKET=kalka-backups
# KALKA_BACKUP_REGION=
# KALKA_BACKUP_ACCESS_KEY_ID=
# KALKA_BACKUP_SECRET_ACCESS_KEY=
# KALKA_BACKUP_PREFIX=kalka-backups
# KALKA_BACKUP_RETENTION_DAYS=30
# KALKA_BACKUP_HOUR=3
