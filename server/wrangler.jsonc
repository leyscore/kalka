{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalka-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ROOMS", "class_name": "DocumentRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "DocumentRoom"] }]
}
