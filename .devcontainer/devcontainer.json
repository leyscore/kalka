{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.base.schema.json",
  "name": "Kalka",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/kalka,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/kalka",
  "remoteUser": "bun",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=kalka-root-modules-${devcontainerId},target=/workspace/kalka/node_modules,type=volume",
    "source=kalka-scene-graph-modules-${devcontainerId},target=/workspace/kalka/packages/scene-graph/node_modules,type=volume",
    "source=kalka-pen-modules-${devcontainerId},target=/workspace/kalka/packages/pen/node_modules,type=volume",
    "source=kalka-kiwi-modules-${devcontainerId},target=/workspace/kalka/packages/kiwi/node_modules,type=volume",
    "source=kalka-fig-modules-${devcontainerId},target=/workspace/kalka/packages/fig/node_modules,type=volume",
    "source=kalka-core-modules-${devcontainerId},target=/workspace/kalka/packages/core/node_modules,type=volume",
    "source=kalka-dom-css-modules-${devcontainerId},target=/workspace/kalka/packages/dom-css/node_modules,type=volume",
    "source=kalka-design-jsx-modules-${devcontainerId},target=/workspace/kalka/packages/design-jsx/node_modules,type=volume",
    "source=kalka-emit-modules-${devcontainerId},target=/workspace/kalka/packages/emit/node_modules,type=volume",
    "source=kalka-vue-modules-${devcontainerId},target=/workspace/kalka/packages/vue/node_modules,type=volume",
    "source=kalka-cli-modules-${devcontainerId},target=/workspace/kalka/packages/cli/node_modules,type=volume",
    "source=kalka-mcp-modules-${devcontainerId},target=/workspace/kalka/packages/mcp/node_modules,type=volume",
    "source=kalka-docs-modules-${devcontainerId},target=/workspace/kalka/packages/docs/node_modules,type=volume",
    "source=kalka-docs-tool-modules-${devcontainerId},target=/workspace/kalka/tools/docs/node_modules,type=volume"
  ],
  "postCreateCommand": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git lfs pull; fi && bun install --frozen-lockfile",
  "containerEnv": {
    "TAURI_DEV_HOST": "0.0.0.0"
  },
  "forwardPorts": [1420],
  "portsAttributes": {
    "1420": {
      "label": "Kalka web editor",
      "onAutoForward": "notify"
    }
  }
}
