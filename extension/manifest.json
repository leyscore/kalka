{
  "manifest_version": 3,
  "name": "Kalka Snapshot",
  "description": "Inspect any site and copy an element into Kalka as editable HTML and CSS layers.",
  "version": "0.1.0",
  "action": {
    "default_title": "Kalka Snapshot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "debugger"
  ],
  "commands": {
    "inspect": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Inspect this page"
    }
  }
}
